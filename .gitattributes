# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must use LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.so binary
*.aar binary

